{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "sdk-57",
        "buildType": "apk"
      }
    },
    "production": {}
  },
  "submit": {
    "internal": {
      "android": {
        "serviceAccountKeyPath": ".eas-secrets/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production-draft": {
      "android": {
        "serviceAccountKeyPath": ".eas-secrets/google-play-service-account.json",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
