    IOS["iOS · arm64<br/>Objective-C++ TurboModule<br/>WhipSsh.xcframework"]

    Android -.->|"installs Runtime + CallInvoker"| JSI
    IOS -.->|"installs Runtime + CallInvoker"| JSI
  end


  Bindings <-->|"typed calls · ArrayBuffer frames<br/>JSON for control operations"| JSI

